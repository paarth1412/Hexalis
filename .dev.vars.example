# Copy to .dev.vars (never committed) and fill in. See lna/README.md.

# Sign in with Google (required: it is the only way to sign in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email notifications (optional). Google Workspace: smtp.gmail.com, 465, the mailbox, its app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM=noreply@hexalis.in   (defaults to SMTP_USER)
# SITE_URL=https://hexalis.in    (for links in emails; defaults to the address /lna is opened at)
